{
  "name": "visflow-vpl-electron",
  "productName": "visflow-vpl-electron",
  "version": "1.0.2",
  "description": "My Electron application description",
  "main": "./src/electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:grammar": "antlr4ng -Dlanguage=TypeScript -visitor -o src/interpreter/generated src/grammar/VisLang.g4",
    "start": "vite build && electron-forge start",
    "package": "vite build && electron-forge package",
    "make": "vite build && electron-forge make",
    "publish": "electron-forge publish"
  },
  "keywords": [],
  "author": {
    "name": "Junedale Gayeta",
    "email": "gayetajunedale0@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0",
    "konva": "^8.4.2",
    "nanoid": "^4.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.5",
    "@electron-forge/maker-deb": "^6.0.5",
    "@electron-forge/maker-rpm": "^6.0.5",
    "@electron-forge/maker-squirrel": "^6.0.5",
    "@electron-forge/maker-zip": "^6.0.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "antlr4ng": "^3.0.16",
    "antlr4ng-cli": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "23.2.0",
    "postcss": "^8.5.3",
    "svelte": "^5.56.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@23.2.0": true,
    "electron-winstaller@5.1.0": true,
    "lzma-native@8.0.6": true
  }
}
